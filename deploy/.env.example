# Postgres (shared instance, per-service databases)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password

# Per-service database names (when running services locally)
# product-service: product_db (or ecommerce for legacy local data)
# user-service: user_db
# cart-service: cart_db
# order-service: order_db

# API gateway (public entry point)
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Downstream service URLs (gateway + inter-service)
PRODUCT_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
CART_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084

# Auth
JWT_SECRET=change-me-in-production

# Frontend (ecommerce-frontend/product-mf)
# VITE_API_BASE_URL=http://localhost:8080
